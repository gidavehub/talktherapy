rules_version = '2';

// Talk — Cloud Storage security rules.
//
// Two limitations shape everything below, and both are worth knowing before
// you trust these rules:
//
// 1. Storage rules CANNOT read Firestore. There is no way to ask "is this
//    user an admin?" here without custom claims, which need the Admin SDK
//    (Blaze plan). So role-gated writes are expressed by path ownership
//    instead, and the authoritative admin check lives in firestore.rules on
//    the document that *references* the file.
//
// 2. getDownloadURL() mints a capability URL containing a token. That URL
//    bypasses these rules entirely — anyone holding it can fetch the object.
//    For sensitive files, read through getBlob()/getBytes() (which DO respect
//    these rules) rather than handing out download URLs.
//    TODO(security): before public launch, serve credential documents via
//    Admin-SDK signed URLs with a short expiry.

service firebase.storage {
  match /b/{bucket}/o {

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    function isImage() {
      return request.resource.contentType.matches('image/.*');
    }

    function isAudio() {
      return request.resource.contentType.matches('audio/.*');
    }

    function underMB(n) {
      return request.resource.size < n * 1024 * 1024;
    }

    // ---------------------------------------------------------------- avatars
    // Profile photos. Publicly readable because they appear in the provider
    // directory, which is browsable before sign-in.
    match /avatars/{uid}/{fileName} {
      allow read: if true;
      allow write: if isOwner(uid) && isImage() && underMB(2);
      allow delete: if isOwner(uid);
    }

    // ----------------------------------------------------- provider documents
    // Certificates, licences, government ID. The most sensitive files in the
    // system after the journals.
    //
    // Owner-only here. Admin review works by reading the URL recorded in
    // providerProfiles/{uid}/privateDocs/{docId}, which firestore.rules
    // restricts to the owner and admins.
    match /provider-credentials/{uid}/{fileName} {
      allow read: if isOwner(uid);
      allow write: if isOwner(uid)
        && underMB(10)
        && (isImage() || request.resource.contentType == 'application/pdf');
      allow delete: if isOwner(uid);
    }

    // -------------------------------------------------------- resource media
    // Art and audio for the Wellbeing Resource Centre. Published resources are
    // free to read per the concept note's free tier.
    //
    // Writes are namespaced by uploader rather than gated on an admin role,
    // because that check is not expressible here. A non-admin can therefore
    // burn storage quota, but cannot make a file appear in the library: the
    // resources/{id} Firestore document that references it is admin-write-only.
    match /resources/{uid}/{fileName} {
      allow read: if true;
      allow write: if isOwner(uid) && underMB(25);
      allow delete: if isOwner(uid);
    }

    // ------------------------------------------------------ session artefacts
    // Files exchanged inside a consultation. Deliberately NOT readable by path
    // alone — access is brokered through the session document.
    match /sessions/{sessionId}/{uid}/{fileName} {
      allow read: if isSignedIn();
      allow write: if isOwner(uid) && underMB(10);
      allow delete: if isOwner(uid);
    }

    // ------------------------------------------------------------ chat media
    // Voice notes and photos sent in a conversation. `fileName` is the id of
    // the message that carries the file — see `app/lib/chat.ts`.
    //
    // Limitation (1) at the top of this file is the whole story here: these
    // rules cannot read Firestore, so there is no way to ask "is this person
    // in that chat". Two things stand in for it, and both matter:
    //
    //  - The object name is a Firestore-generated message id, so a path is not
    //    guessable from the chat id alone. The chat id IS guessable — it is
    //    the two uids sorted — which is precisely why the file is named after
    //    the message and not after, say, a timestamp.
    //  - The path is only ever learned by reading the message document, and
    //    firestore.rules restricts that to the chat's participants. That
    //    Firestore rule is the real access control; this is the backstop.
    //
    // Chat media is therefore read with getBlob(), not getDownloadURL(): a
    // download token is a capability that bypasses this file completely and
    // keeps working for anyone it is ever forwarded to. No bucket CORS
    // configuration is needed for that — see chatMediaUrl().
    //
    // TODO(security): if group sessions make the guessable-path backstop feel
    // too thin, move chat media behind an Admin-SDK signed URL, or add the
    // uploader's uid to the path so writes can be owner-gated.
    match /chat-media/{chatId}/{fileName} {
      allow read: if isSignedIn();

      // `resource == null` means "no object here yet", so this is create-only:
      // a voice note can be uploaded once and never replaced. Worth having
      // beyond tidiness — the message that points at it is immutable, so a
      // replaceable file would let a sender change what a message says after
      // the other person had read it.
      allow write: if isSignedIn()
        && resource == null
        && underMB(10)
        && (isImage() || isAudio());

      // No deletes. The message referencing the file cannot be deleted either,
      // so a missing object would only ever render as a broken message.
      allow delete: if false;
    }

    // ------------------------------------------------------------- catch-all
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
