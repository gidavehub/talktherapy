# Firebase web app config.
# Copy this file to `.env.local` and fill in the values from:
#   Firebase console -> Project settings -> General -> Your apps -> Web app -> Config
# Everything NEXT_PUBLIC_* is inlined into the browser bundle at build time.
# That is expected for Firebase web keys — they identify the project, they do
# not authorise it. Access is controlled by firestore.rules / storage.rules.

NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Optional — only needed for Analytics.
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=

# Optional — only if you enable Realtime Database. WebRTC signaling uses
# Firestore, so this can stay blank.
NEXT_PUBLIC_FIREBASE_DATABASE_URL=

# --- Modem Pay (server-side only, never NEXT_PUBLIC_) ------------------------
# https://docs.modempay.com. Read only inside route handlers under
# app/api/payments/ — these must never reach the browser.
#
# Four names, one set. An earlier draft of this file called the first one
# MODEM_PAY_API_KEY; nothing reads that name any more, so delete it from your
# .env.local if it is still there.

# Dashboard -> Developers -> API Keys -> "Secret key" (starts sk_).
# Authenticates every request to api.modempay.com as `Bearer <key>`, AND is the
# key Modem Pay signs per-intent callback_url deliveries with. Rotating it
# therefore invalidates in-flight webhooks as well as API calls.
MODEM_PAY_SECRET_KEY=

# Dashboard -> Developers -> API Keys -> "Public key" (starts pk_).
# Only needed by Modem Pay's browser SDK for an embedded checkout. This
# integration is hosted-redirect only, so it can stay blank — it is listed so
# nobody reintroduces a second naming scheme for it later.
MODEM_PAY_PUBLIC_KEY=

# Dashboard -> Settings -> Business profile -> "Merchant ID".
# Not sent on any request below; kept for support tickets, reconciliation and
# the payout work that comes with provider bookings.
MODEM_PAY_MERCHANT_ID=

# Dashboard -> Developers -> Webhooks -> your endpoint -> "Signing secret".
# ONLY used for deliveries from a webhook you configure in the dashboard.
# Modem Pay signs those with this secret and per-intent callback_url deliveries
# with MODEM_PAY_SECRET_KEY above, and nothing in the request says which — so
# the verifier tries both. Leave blank if you rely only on callback_url.
MODEM_PAY_WEBHOOK_SECRET=

# "simulated" | "modempay". Defaults to simulated everywhere, including in
# production: a half-configured deployment should fail to take money rather
# than take it badly. The simulated provider settles instantly and needs no
# keys and no network.
PAYMENTS_PROVIDER=simulated

# This deployment's own public origin, no trailing slash, e.g.
# https://talk.gm. Modem Pay has to be able to reach `callback_url` from the
# outside, so it cannot be guessed from an incoming request that arrived via a
# proxy or a tunnel hostname. Falls back to the request's origin, which is
# correct for `next dev` and nowhere else.
APP_BASE_URL=

# --- Google Cloud service accounts (server-side only) ------------------------
# Two accounts on purpose: a leaked AI key must not be able to read journals.
#   talk-ai    -> roles/aiplatform.user ONLY. No database access at all.
#   talk-admin -> Firestore + Auth + Storage admin, for the payment webhook,
#                 custom claims and admin operations.
# Both key files live in /secrets, which is gitignored. Never commit them.
GOOGLE_CLOUD_PROJECT=
VERTEX_LOCATION=global
TALK_AI_CREDENTIALS=./secrets/talk-ai-sa.json
TALK_ADMIN_CREDENTIALS=./secrets/talk-admin-sa.json

# Where there is no filesystem for key files (Vercel, App Hosting), put the
# talk-ai key's JSON here instead of TALK_AI_CREDENTIALS.
TALK_AI_CREDENTIALS_JSON=

# Models. No fallbacks — if one of these is wrong the call must fail loudly.
GEMINI_TEXT_MODEL=gemini-3.8-flash
GEMINI_TTS_MODEL=gemini-3.1-flash-tts-preview

# Talk's voice (a prebuilt voice of the TTS model). Audition candidates with
# `npm run probe:models -- --tts`.
TALK_VOICE=Vindemiatrix

# DEV ONLY. Lets /api/companion/* answer without a signed-in user under
# `next dev`, for local testing. Every production build ignores it
# (NODE_ENV=production), so it cannot open a deployed route.
TALK_DEV_ALLOW_ANON_AI=

# --- Video sessions (TURN relay) --------------------------------------------
# Sessions are peer-to-peer WebRTC inside Talk — see app/lib/call.ts for why
# Google Meet is not an option here.
#
# STUN alone (hard-coded, free, Google's) is enough on wifi and most fixed
# lines. It is NOT enough on Gambian mobile data: carrier-grade NAT means
# neither side can be reached directly, and the call simply never connects.
# A TURN server relays the media in that case, and it is the one piece of
# this that costs money — bandwidth, charged per gigabyte.
#
# Until these are set the call screen says plainly that a relay is missing
# rather than spinning for ever. NEXT_PUBLIC_ because the browser does the
# connecting; TURN credentials are short-lived by design, and a production
# setup should mint them per call rather than shipping a static pair.
NEXT_PUBLIC_TURN_URL=
NEXT_PUBLIC_TURN_USERNAME=
NEXT_PUBLIC_TURN_CREDENTIAL=
