# Firebase web app config.
# Copy this file to `.env.local` and fill in the values from:
#   Firebase console -> Project settings -> General -> Your apps -> Web app -> Config
# Everything NEXT_PUBLIC_* is inlined into the browser bundle at build time.
# That is expected for Firebase web keys — they identify the project, they do
# not authorise it. Access is controlled by firestore.rules / storage.rules.

NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Optional — only needed for Analytics.
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=

# Optional — only if you enable Realtime Database. WebRTC signaling uses
# Firestore, so this can stay blank.
NEXT_PUBLIC_FIREBASE_DATABASE_URL=

# --- Modem Pay -------------------------------------------------------------
# NOT HERE. The merchant key and the webhook signing secret live in Google
# Secret Manager, next to the Cloud Functions that use them:
#
#   firebase functions:secrets:set MODEM_PAY_SECRET_KEY
#   firebase functions:secrets:set MODEM_PAY_WEBHOOK_SECRET
#   cd functions && npm run build && firebase deploy --only functions
#
# A web host holds the public Firebase config and nothing more. Anything that
# holds a merchant key or writes with admin rights runs in functions/, as the
# project's own service account — see functions/src/index.ts.
#
# The webhook URL to register in the Modem Pay dashboard:
#   https://us-east4-talk-therapy-509209.cloudfunctions.net/modemWebhook
#
# A dashboard webhook is optional: this integration sets a per-intent
# callback_url, and those deliveries are signed with the MERCHANT key, which
# the function already has.
#
# The only place these appear outside Secret Manager is a developer's own
# .env.local, where scripts/smoke-payments-webhook.mjs reads the merchant key
# to sign a test delivery with.

# --- Video sessions (TURN relay) --------------------------------------------
# Sessions are peer-to-peer WebRTC inside Talk — see app/lib/call.ts for why
# Google Meet is not an option here.
#
# STUN alone (hard-coded, free, Google's) is enough on wifi and most fixed
# lines. It is NOT enough on Gambian mobile data: carrier-grade NAT means
# neither side can be reached directly, and the call simply never connects.
# A TURN server relays the media in that case, and it is the one piece of
# this that costs money — bandwidth, charged per gigabyte.
#
# Until these are set the call screen says plainly that a relay is missing
# rather than spinning for ever. NEXT_PUBLIC_ because the browser does the
# connecting; TURN credentials are short-lived by design, and a production
# setup should mint them per call rather than shipping a static pair.
NEXT_PUBLIC_TURN_URL=
NEXT_PUBLIC_TURN_USERNAME=
NEXT_PUBLIC_TURN_CREDENTIAL=
