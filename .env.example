# Firebase web app config.
# Copy this file to `.env.local` and fill in the values from:
#   Firebase console -> Project settings -> General -> Your apps -> Web app -> Config
# Everything NEXT_PUBLIC_* is inlined into the browser bundle at build time.
# That is expected for Firebase web keys — they identify the project, they do
# not authorise it. Access is controlled by firestore.rules / storage.rules.

NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Optional — only needed for Analytics.
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=

# Optional — only if you enable Realtime Database. WebRTC signaling uses
# Firestore, so this can stay blank.
NEXT_PUBLIC_FIREBASE_DATABASE_URL=

# --- Server-side only (never NEXT_PUBLIC_) -----------------------------------
# Modem Pay (https://docs.modempay.com). Read only inside route handlers under
# app/api/payments/ — must never reach the browser.
MODEM_PAY_API_KEY=
MODEM_PAY_WEBHOOK_SECRET=

# "simulated" | "modempay"
PAYMENTS_PROVIDER=simulated
