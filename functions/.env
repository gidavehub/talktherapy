# Cloud Functions settings — NOT secrets (those live in Secret Manager:
# MODEM_PAY_SECRET_KEY, MODEM_PAY_WEBHOOK_SECRET). The Firebase CLI reads this
# file at deploy time and sets every key on every function; a key missing here
# is REMOVED from the live functions on the next deploy, so keep them all.
#
#   VERTEX_LOCATION     region for the Gemini text model
#   GEMINI_TEXT_MODEL   Talk's conversation model (never substituted)
#   GEMINI_TTS_MODEL    Talk's voice model
#   TALK_VOICE          the voice she speaks in
#   CONSULTATION_GATE   "on" charges the D200 before a conversation
#   APP_BASE_URL        where a checkout sends people back to (the live site)
VERTEX_LOCATION=global
GEMINI_TEXT_MODEL=gemini-3.8-flash
GEMINI_TTS_MODEL=gemini-3.1-flash-tts-preview
TALK_VOICE=Vindemiatrix
CONSULTATION_GATE=on
APP_BASE_URL=https://www.talktherapy.gm
