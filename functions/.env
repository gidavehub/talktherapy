# Plain settings for the Cloud Functions. The Firebase CLI reads this file on
# `firebase deploy --only functions` and sets each line as an env var.
# Never put a secret here — this file is committed. Secrets go in Secret
# Manager (see MODEM_PAY_* in the root .env.example).

# Where a shopper's browser lands after paying (functions/src/index.ts appUrl).
# Must be the address people sign in on: Firebase sign-in is per address, so
# anywhere else they arrive signed out.
APP_BASE_URL=https://talktherapy.gm
