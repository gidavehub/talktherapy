rules_version = '2';

// Talk — Firestore security rules.
//
// Threat model worth stating plainly: this database holds journal entries,
// mood history and mental-health disclosures. A read leak here is not a bug,
// it is a harm. So the default is deny, private data lives in subcollections
// under its owner (making the rule a trivial uid match), and nothing is
// readable "because you are signed in".
//
// Role lives on users/{uid}.role and is read back with get(). Custom claims
// would be cheaper, but they require the Admin SDK (Blaze plan), which this
// project is not on yet. Every get() below costs a document read and Firestore
// caps them at 10 per request, so helpers are kept shallow deliberately.
//
// Bootstrapping the first admin: create the user normally, then edit
// users/{uid}.role to "admin" by hand in the Firebase console. No code path
// can mint an admin — see the role-escalation guard in /users/{uid}.

service cloud.firestore {
  match /databases/{database}/documents {

    // ---------------------------------------------------------------- helpers

    function isSignedIn() {
      return request.auth != null;
    }

    function isSelf(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    function userDoc() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function hasRole(role) {
      return isSignedIn() && userDoc().role == role;
    }

    function isAdmin() {
      return hasRole('admin');
    }

    // A provider who has actually cleared credential review. Anything that
    // exposes a provider to patients must check this, not just the role.
    function isVerifiedProvider() {
      return isSignedIn()
        && userDoc().role == 'provider'
        && userDoc().verified == true;
    }

    // Fields a user may never set on themselves. Privilege escalation guard.
    // The role-change record is pinned too: staff read it on the account
    // page as who changed the role and what it was before, so the owner must
    // not be able to rewrite it. Only the adminSetRole function writes it.
    function keepsPrivilegeFields(existing) {
      return request.resource.data.role == existing.role
        && request.resource.data.verified == existing.verified
        && request.resource.data.get('previousRole', null) == existing.get('previousRole', null)
        && request.resource.data.get('roleChangedAt', null) == existing.get('roleChangedAt', null)
        && request.resource.data.get('roleChangedBy', null) == existing.get('roleChangedBy', null);
    }

    // ------------------------------------------------------------------ users

    match /users/{uid} {
      // A user reads their own doc. Admins read anyone. Providers do NOT get
      // blanket read over patients — they see only the patients who booked
      // them, and that link is resolved through /bookings, not here.
      allow get: if isSelf(uid) || isAdmin();
      allow list: if isAdmin();

      // On create you may only make yourself, only as patient or provider,
      // and `verified` is forced: patients are trivially verified (the flag is
      // meaningless for them), providers must start unverified and be
      // approved by an admin.
      allow create: if isSelf(uid)
        && request.resource.data.role in ['patient', 'provider']
        && request.resource.data.verified == (request.resource.data.role == 'patient')
        && !request.resource.data.keys().hasAny(['previousRole', 'roleChangedAt', 'roleChangedBy']);

      // Self-updates may not touch role, verified or the role-change record.
      // Staff get no browser write here at all: a role changes only through
      // the adminSetRole function, which keeps the last admin, syncs the
      // admin claim and writes the audit log. A direct write would skip all
      // three.
      allow update: if isSelf(uid) && keepsPrivilegeFields(resource.data);

      // Account deletion is a data right, so owners may delete themselves.
      allow delete: if isSelf(uid) || isAdmin();

      // ------------------------------------------------ private wellbeing data
      //
      // Mood, journal and consent history. Owner only — no admin read, no
      // provider read, ever. If a provider needs context, the patient
      // shares it deliberately through a session note, not by us opening a
      // back door here.

      match /moodEntries/{entryId} {
        allow read, write: if isSelf(uid);
      }

      match /journalEntries/{entryId} {
        allow read, write: if isSelf(uid);
      }

      // Append-only consent ledger. Users can see what they agreed to and
      // when; nobody can rewrite history, including them.
      match /consentEvents/{eventId} {
        allow read: if isSelf(uid) || isAdmin();

        // A consent record is evidence, so its shape is fixed and its time is
        // the SERVER's. Without the last clause a client could write a
        // recordedAt of its choosing — a consent "given" last week, before the
        // session it is being used to justify. `detail` carries the language,
        // spoken-or-tapped, and a guardian's relationship and typed name.
        allow create: if isSelf(uid)
          && request.resource.data.keys().hasOnly(['key', 'granted', 'surface', 'recordedAt', 'detail'])
          && request.resource.data.key is string
          && request.resource.data.granted is bool
          && request.resource.data.surface is string
          && request.resource.data.recordedAt == request.time;

        allow update, delete: if false;
      }
    }

    // ------------------------------------------------------- provider profiles

    match /providerProfiles/{uid} {
      // The public directory only ever shows verified providers. Unverified
      // and suspended profiles are visible to their owner and to admins.
      allow get, list: if resource.data.status == 'verified'
        || isSelf(uid)
        || isAdmin();

      // A listing is made by approval, never by its owner: the
      // reviewProviderApplication function writes it from the application a
      // member of staff has just checked. A provider who could create their
      // own could list themselves with qualifications nobody had seen.
      allow create: if isAdmin();

      // The owner may keep their listing up to date — how they describe
      // themselves, their languages, their fee — and nothing that review
      // decided. This used to be "anything, as long as status is unchanged",
      // which let a provider set their own rating, mark themselves a sample
      // or rewrite the qualifications that were checked. Now it is a list.
      //
      // The fee is held to the published range: 70000 and 300000 bututs are
      // HUMAN_RATE_MIN_MINOR and HUMAN_RATE_MAX_MINOR in app/lib/models.ts.
      // The photo must be their own, at the path the directory reads.
      allow update: if (isSelf(uid)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
               'displayName', 'headline', 'bio', 'approach', 'firstSession', 'languages',
               'specializations', 'ageGroups', 'yearsExperience', 'sessionRateMinor',
               'gender', 'location', 'photoPath', 'formats', 'updatedAt'])
          && request.resource.data.sessionRateMinor is int
          && request.resource.data.sessionRateMinor >= 70000
          && request.resource.data.sessionRateMinor <= 300000
          && (request.resource.data.get('photoPath', null) == null
              || request.resource.data.photoPath == 'avatars/' + uid + '/provider.jpg'))
        || isAdmin();

      allow delete: if isAdmin();

      // Credential documents (certificates, ID). Owner and admin only.
      //
      // NOTE: these docs hold Storage download URLs, which are capability
      // URLs — anyone holding one can fetch the file regardless of Storage
      // rules. Gating the URL here is what actually restricts access.
      // TODO(security): before public launch, move to Admin-SDK-issued signed
      // URLs with an expiry so a leaked link stops working.
      //
      // Superseded by the application (providerApplications below), whose
      // documents are never handed out as download URLs at all. Kept readable
      // so nothing already there is lost; nothing new is written here.
      match /privateDocs/{docId} {
        allow read: if isSelf(uid) || isAdmin();
        allow create, update: if false;
        allow delete: if isSelf(uid) || isAdmin();
      }
    }

    // The old credential review queue, replaced by providerApplications.
    // Readable for what is already there; nothing new is created.
    match /verificationRequests/{requestId} {
      allow get, list: if isAdmin()
        || (isSignedIn() && resource.data.providerId == request.auth.uid);
      allow create: if false;
      allow update, delete: if isAdmin();
    }

    // -------------------------------------------------- provider applications

    // providerApplications/{uid} — a provider's application to join, filled
    // in step by step from the browser. See app/lib/providerApplication.ts.
    //
    // The applicant writes the step sections of their OWN application, and
    // only while it is a draft or has been sent back for changes. The status,
    // the staff message, the history and every decision are written by the
    // functions alone, so nobody sends, approves or un-rejects themselves.
    match /providerApplications/{uid} {
      // APPLICANT_KEYS in app/lib/providerApplication.ts — keep them equal.
      function applicantKeys() {
        return ['personal', 'professional', 'qualifications', 'practice', 'fee', 'photo',
                'documents', 'availability', 'payout', 'agreements', 'lastStep', 'updatedAt'];
      }

      // Limits a real application never reaches and a script stuffing the
      // document would. The functions check everything else on submit.
      function sane(data) {
        return (!('documents' in data) || (data.documents is list && data.documents.size() <= 12))
          && (!('qualifications' in data) || (data.qualifications is list && data.qualifications.size() <= 8))
          && (!('availability' in data) || data.availability.get('ranges', []).size() <= 30);
      }

      allow get: if isSelf(uid) || isAdmin();
      allow list: if isAdmin();

      // Started by a provider account, as a draft, as themselves.
      allow create: if isSelf(uid)
        && hasRole('provider')
        && request.resource.data.uid == uid
        && request.resource.data.status == 'draft'
        && request.resource.data.keys().hasOnly(applicantKeys().concat(['uid', 'status', 'createdAt']))
        && sane(request.resource.data);

      allow update: if isSelf(uid)
        && resource.data.status in ['draft', 'changes_requested']
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(applicantKeys())
        && sane(request.resource.data);

      // An application is a record of what someone claimed and what was
      // decided about it. Nobody deletes that from the browser.
      allow delete: if false;
    }

    // providerReviews/{uid} — staff's working space for one application: the
    // checklist, what they made of each document, and their notes. Never
    // readable by the applicant, which is why it is not on the application.
    match /providerReviews/{uid} {
      allow read, write: if isAdmin();

      // Notes are a record, so they are added and never edited, under the
      // name of whoever wrote them, at the server's time.
      match /notes/{noteId} {
        allow read: if isAdmin();
        allow create: if isAdmin()
          && request.resource.data.keys().hasOnly(['authorId', 'authorName', 'body', 'createdAt'])
          && request.resource.data.authorId == request.auth.uid
          && request.resource.data.authorName is string
          && request.resource.data.authorName.size() <= 80
          && request.resource.data.body is string
          && request.resource.data.body.size() > 0
          && request.resource.data.body.size() <= 2000
          && request.resource.data.createdAt == request.time;
        allow update, delete: if false;
      }
    }

    // notifications/{id} — something for one person to see in the app, or for
    // every member of staff (`to: "staff"`). Written only by the functions.
    // The one thing a recipient may change is marking it read.
    match /notifications/{notificationId} {
      allow get, list: if isSignedIn()
        && (resource.data.to == request.auth.uid
            || (resource.data.to == 'staff' && isAdmin()));
      allow update: if isSignedIn()
        && resource.data.to == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['readAt'])
        && request.resource.data.readAt is number;

      // A notice for staff is shared, so one person reading it must not clear
      // it for the rest. Each member of staff marks it read for themselves by
      // adding their own uid to `readBy` (an arrayUnion) — never anybody
      // else's, never taking one away, and changing nothing else.
      allow update: if resource.data.to == 'staff'
        && isAdmin()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['readBy'])
        && request.resource.data.readBy is list
        && request.resource.data.readBy.toSet()
             == resource.data.get('readBy', []).toSet().union([request.auth.uid].toSet())
        && request.resource.data.readBy.size() <= resource.data.get('readBy', []).size() + 1;

      allow create, delete: if false;
    }

    // ------------------------------------------------------------- hand-offs

    // handoffs/{pairId} — the short summary of what somebody told TALK, for
    // the provider they chose (functions/src/handoff.ts). The id is the
    // pair's chat id. Read by the two people it is about and nobody else —
    // not staff, for the same reason staff cannot read chats. Written only by
    // the functions, which check the consent; the person takes it back
    // through them too, so it can never be quietly re-shared from a browser.
    match /handoffs/{pairId} {
      allow get, list: if isSignedIn() && request.auth.uid in resource.data.participants;
      allow write: if false;
    }

    // -------------------------------------------------------- availability

    match /availability/{providerId} {
      allow read: if isSignedIn();
      allow write: if isSelf(providerId) || isAdmin();

      match /slots/{slotId} {
        // Patients must see open slots to book them.
        allow read: if isSignedIn();
        allow write: if isSelf(providerId) || isAdmin();
      }
    }

    // ------------------------------------------------------------- bookings

    match /bookings/{bookingId} {
      // `participants` is a denormalised [patientId, providerId]. It lets one
      // composite index serve "my bookings" for both roles, and makes this rule
      // a membership test with zero extra document reads.
      function isParticipant() {
        return isSignedIn() && request.auth.uid in resource.data.participants;
      }

      allow get, list: if isParticipant() || isAdmin();

      // NO CLIENT WRITES. Booking and cancelling both go through
      // app/lib/server/bookings.ts, which runs with the Admin SDK and so is
      // not subject to this rule.
      //
      // This used to allow a patient to create their own booking, and that
      // could not be made safe. A booking and the slot it takes have to change
      // together, and a patient cannot write a provider's slots — so a
      // client-side booking left the slot looking free, and the second patient
      // to choose that time found out when nobody joined the call. The server
      // does both in one transaction, reading the slot's state inside it.
      //
      // The fee is the other half: it is read from the provider's profile
      // there, never sent by the client, so nobody books a D3,000 session for
      // a dalasi.
      allow create, update: if isAdmin();

      // The ONE exception: the provider may attach, change or clear a Google
      // Meet link on their own session — the fallback for anyone who would
      // rather meet there. That field and its timestamp, nothing else, and
      // only a meet.google.com address. Any URL at all would be a way to put a
      // link of somebody's choosing in front of a person at the exact moment
      // they are about to see their provider.
      allow update: if isSignedIn()
        && request.auth.uid == resource.data.providerId
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['meetUrl', 'updatedAt'])
        && (request.resource.data.meetUrl == null
            || (request.resource.data.meetUrl is string
                && request.resource.data.meetUrl.matches('^https://meet[.]google[.]com/[A-Za-z0-9-]+([?].*)?$')));

      allow delete: if isAdmin();
    }

    // ------------------------------------------------------------- sessions

    match /sessions/{sessionId} {
      function isSessionParticipant() {
        return isSignedIn() && request.auth.uid in resource.data.participants;
      }

      allow get, list: if isSessionParticipant() || isAdmin();
      allow create: if isSignedIn()
        && request.resource.data.patientId == request.auth.uid
        && request.auth.uid in request.resource.data.participants;
      allow update: if isSessionParticipant() || isAdmin();
      allow delete: if isAdmin();

      // Transcript / in-session chat.
      //
      // `participants` is denormalised onto every message ON PURPOSE. The
      // obvious rule — get() the parent session — costs a billed read on every
      // single message write, and a companion conversation produces hundreds.
      // At free-tier quota (50k reads/day) that alone would sink the app.
      // Denormalising trades a few bytes per document for zero reads.
      match /messages/{messageId} {
        allow read: if (isSignedIn() && request.auth.uid in resource.data.participants)
          || isAdmin();
        allow create: if isSignedIn()
          && request.auth.uid in request.resource.data.participants;
        // Immutable once written — a therapy transcript nobody can quietly
        // edit is worth more than a convenient one.
        allow update, delete: if false;
      }

      // Clinical notes. Written by the provider, never visible to the
      // patient through this path, never visible to other providers.
      match /notes/{noteId} {
        allow read, write: if isSignedIn()
          && get(/databases/$(database)/documents/sessions/$(sessionId)).data.providerId == request.auth.uid;
      }
    }

    // ---------------------------------------------------------------- chats

    // Conversations between a person and the provider they are working with.
    // This collection holds the same class of disclosure as a journal entry,
    // so "deny unless you are in the participant list" is doing real work
    // here, not paperwork.
    //
    // There is no admin read. An admin can already escalate a crisis without
    // reading the conversation, and a support team able to open anyone's
    // therapy chat is a far bigger liability than the occasional support
    // ticket it would resolve.
    match /chats/{chatId} {
      function isChatParticipant() {
        return isSignedIn() && request.auth.uid in resource.data.participants;
      }

      // `list` is safe to allow on the same condition because Firestore
      // evaluates it against every document a query actually returns: the
      // chat-list query filters on `participants array-contains <me>`, and a
      // query that reached somebody else's chat would be refused outright
      // rather than filtered.
      allow get, list: if isChatParticipant();

      // Whoever opens the conversation must be in it. Two is the minimum; the
      // ceiling is a brake on a script creating a thousand-person thread, not
      // a product limit — group sessions are nowhere near 50.
      //
      // The last clause is the one that is easy to miss: a two-person chat's
      // id IS its participants, sorted and joined with "__" (see
      // directChatId), and that has to be enforced here rather than trusted.
      // Without it a stranger can create the document at the id two other
      // people's chat WOULD have, with themselves as the only participant.
      // They could never read it — but the real patient could never open it
      // either, because `openChat` would then be making an update to a chat
      // it is not a participant of, and be refused for ever. A conversation
      // that can be pre-emptively broken by anybody who knows two uids is not
      // a conversation.
      //
      // Group chats get a generated id with nothing to check it against, so
      // the clause only applies to the pair case.
      allow create: if isSignedIn()
        && request.auth.uid in request.resource.data.participants
        && request.resource.data.participants.size() >= 2
        && request.resource.data.participants.size() <= 50
        && (
          // A two-person chat lives at the id derived from the pair.
          (request.resource.data.participants.size() == 2
            && chatId == request.resource.data.participants.join('__')
            // Not a group in disguise: one whose "creator" could later take
            // the other person out of their own conversation.
            && request.resource.data.get('createdBy', null) == null
            && request.resource.data.get('group', null) == null)
          ||
          // A group session is PROVIDER-LED: only a provider may start one,
          // and must record themselves as the one who did. A client cannot
          // gather other clients into a room — peer groups are a later, more
          // deliberate decision, not something that falls out of this rule.
          (request.resource.data.participants.size() > 2
            // A provider whose application was APPROVED — not merely an
            // account that says provider, which anybody can make.
            && isVerifiedProvider()
            && request.resource.data.createdBy == request.auth.uid
            && request.resource.data.get('group', 'led') in ['led', 'peer']
            // Never at a pair-shaped id: a group made at the id two other
            // people's conversation WOULD have would be walked into by them,
            // with its creator reading along. Generated ids never hold '__'.
            && chatId.split('__').size() == 1
            // Nobody listed twice: a member listed twice could never leave.
            && request.resource.data.participants.toSet().size()
                 == request.resource.data.participants.size())
        );

      // One person out of a group, nobody in: yourself — anybody may leave,
      // always; nobody is kept in a room — or somebody else, by the provider
      // who set the group up. Only the membership and that person's counters
      // may change with it. Messages already sent keep their own copy of who
      // was in the room, so whoever left keeps what they were part of and
      // sees nothing new.
      function isLeavingOrRemoval() {
        let before = resource.data.participants;
        let after = request.resource.data.participants;
        let gone = before.removeAll(after);
        return resource.data.get('createdBy', null) != null
          && after.size() == before.size() - 1
          && before.hasAll(after)
          && gone.size() == 1
          && (gone[0] == request.auth.uid || resource.data.createdBy == request.auth.uid)
          && request.resource.data.diff(resource.data).affectedKeys()
               .hasOnly(['participants', 'unread', 'typing']);
      }

      // Participants are immutable, and this is the most important line in the
      // block. Everything else here — the preview, the unread counters, the
      // typing timestamps — is written by both sides in the ordinary course of
      // sending a message, so the rule has to stay permissive about those.
      // But adding a uid to a live chat would retroactively hand that person
      // every message already in it, because the message rule below trusts the
      // same array. Pinning it is what stops a participant doing that.
      //
      // Who set a group up, and what kind of group it is, are pinned too:
      // removing somebody is that person's power, so it must not be claimable
      // by rewriting `createdBy`.
      allow update: if isChatParticipant()
        && request.resource.data.get('createdBy', null) == resource.data.get('createdBy', null)
        && request.resource.data.get('group', null) == resource.data.get('group', null)
        && (request.resource.data.participants == resource.data.participants
            || isLeavingOrRemoval());

      // Nobody deletes a conversation from the client. One side deleting the
      // thread would destroy the other person's copy of it, and a therapeutic
      // record is not one party's to erase.
      allow delete: if false;

      match /messages/{messageId} {
        // `participants` is copied from the parent chat onto every message ON
        // PURPOSE, exactly as the session transcript above does it. The
        // obvious rule — get() the parent chat on every read — bills a
        // document read per message read, and a conversation that is working
        // produces hundreds against a 50k reads/day quota.
        //
        // Reads therefore trust the copied array. What makes that safe is the
        // create rule below, which is the only thing that ever writes it.
        allow read: if isSignedIn()
          && request.auth.uid in resource.data.participants;

        // You may only write a message as yourself, into a chat you are in,
        // carrying that chat's real participant list.
        //
        // This get() is the one read this design does pay for, and it is not
        // optional. Checking only `request.resource.data.participants` tests
        // an array the sender just made up: anybody signed in could write a
        // message into any chat id they can derive from two uids, listing
        // whoever they like. They still could not read the thread — but
        // "rules are not filters" means a single injected message that omits
        // one participant makes that person's whole thread query fail, and
        // their conversation vanishes. Verified against the live evaluator in
        // scripts/test-security-rules.mjs, which is where this hole was found.
        //
        // The cost is one document read per message SENT, never per message
        // read, so the quota argument above is untouched.
        allow create: if isSignedIn()
          && request.resource.data.senderId == request.auth.uid
          && request.auth.uid in request.resource.data.participants
          && request.resource.data.participants
               == get(/databases/$(database)/documents/chats/$(chatId)).data.participants;

        // Read receipts are the single permitted mutation, and only your own.
        // The diff must touch nothing but `readBy`, and the only uid it may
        // add is the caller's: without that last clause a participant could
        // mark a message read on someone else's behalf, which is a small lie
        // with an outsized effect on whether a person feels heard.
        //
        // Everything else about a message stays immutable once written, for
        // the same reason the session transcript does.
        allow update: if isSignedIn()
          && request.auth.uid in resource.data.participants
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['readBy'])
          && request.resource.data.readBy is list
          && request.resource.data.readBy.hasAll(resource.data.readBy)
          && request.resource.data.readBy.removeAll(resource.data.readBy)
               .hasOnly([request.auth.uid]);

        allow delete: if false;
      }
    }

    // ------------------------------------------------- WebRTC call signaling

    // groupCalls/{chatId} — a group's call. The room IS the group chat, so
    // who may be in it is the group's CURRENT membership, read from the chat
    // every time. Never a copy taken when the room was first opened: that
    // would lock the call for good the first time somebody left the group,
    // and leave whoever was taken out still able to signal into it.
    match /groupCalls/{chatId} {
      function chatMembers() {
        return get(/databases/$(database)/documents/chats/$(chatId)).data.participants;
      }

      allow get: if isSignedIn() && request.auth.uid in chatMembers();
      // Opening the room, or refreshing it after the group has changed: the
      // list it carries must be the chat's own, exactly.
      allow create, update: if isSignedIn()
        && request.auth.uid in chatMembers()
        && request.resource.data.participants == chatMembers();
      allow delete: if false;

      // Who is in the call now. Everyone in the group can see it, so a call
      // that is on shows before you join it. Each person writes only their
      // own, and only while they are in the group.
      match /present/{uid} {
        allow read: if isSignedIn() && request.auth.uid in chatMembers();
        allow create, update: if isSelf(uid)
          && request.auth.uid in chatMembers()
          && request.resource.data.uid == uid;
        allow delete: if isSelf(uid);
      }

      // One connection per pair, id = the two uids sorted. Only that pair
      // reads or writes it: the rest of the group cannot see who is
      // negotiating with whom, let alone inject into it.
      match /links/{pair} {
        function inPair() {
          return isSignedIn()
            && request.auth.uid in pair.split('__')
            && pair.split('__')[0] in chatMembers()
            && pair.split('__')[1] in chatMembers();
        }
        allow read, create, update: if inPair();
        allow delete: if false;

        match /candidates/{candidateId} {
          allow read: if inPair();
          allow create: if inPair() && request.resource.data.from == request.auth.uid;
          // Each side clears away its own from earlier connections, so a
          // group that meets every week does not re-read months of them.
          allow delete: if inPair() && resource.data.from == request.auth.uid;
          allow update: if false;
        }
      }
    }

    // Short-lived SDP offer/answer and ICE candidates. Contents are useless
    // without also being the live peer, but they still identify who is talking
    // to whom, so they stay locked to the two participants.
    match /calls/{sessionId} {
      // Same denormalisation as messages: ICE candidates arrive in bursts of
      // dozens, and a parent lookup per candidate is pure waste.
      function isCallParticipant() {
        return isSignedIn() && request.auth.uid in resource.data.participants;
      }

      allow read: if isCallParticipant();

      // When the call first began (firstJoinedAt, written by whoever finds no
      // room) and last ended (endedAt, at each hang-up) give the staff numbers
      // how long sessions last (functions/src/adminStats.ts). Each is the
      // server's time as it is written, or left as it was — never a time a
      // browser chose, which could stretch or shrink a session.
      function stampedOrKept(field) {
        return !(field in request.resource.data)
          || request.resource.data[field] == request.time
          || (resource != null && request.resource.data[field] == resource.data.get(field, null));
      }

      // The room is created by whoever arrives first, and its id IS the
      // booking's — so the participant list has to be the booking's too,
      // checked against the booking itself rather than taken on trust.
      //
      // Without that last clause anybody signed in could create the room for
      // a session between two other people, listing only themselves. They
      // could not hear anything: the room would hold no offer and they would
      // never be sent one. But the two people who actually have the
      // appointment would both fail to create it, both fail the update rule
      // they are not participants of, and sit looking at a call that never
      // connects, at the exact moment one of them most needs it to.
      //
      // One document read, once per call, at the only moment it is cheap.
      allow create: if isSignedIn()
        && request.auth.uid in request.resource.data.participants
        && request.resource.data.participants ==
             get(/databases/$(database)/documents/bookings/$(sessionId)).data.participants
        && stampedOrKept('firstJoinedAt')
        && stampedOrKept('endedAt');
      allow update: if isCallParticipant()
        && request.resource.data.participants == resource.data.participants
        && stampedOrKept('firstJoinedAt')
        && stampedOrKept('endedAt');
      allow delete: if isCallParticipant();

      // Candidates inherit the room's participant list through one get() on
      // the room document — not the session — which is a single cached read
      // per request rather than one per candidate.
      function inRoom() {
        return isSignedIn() && request.auth.uid in
          get(/databases/$(database)/documents/calls/$(sessionId)).data.participants;
      }

      match /callerCandidates/{candidateId} {
        allow read, write: if inRoom();
      }

      match /calleeCandidates/{candidateId} {
        allow read, write: if inRoom();
      }
    }

    // --------------------------------------------------------- transactions

    // Money is server-authoritative. Clients read their own history and write
    // nothing — every mutation comes from the Modem Pay webhook route handler.
    match /transactions/{transactionId} {
      allow get, list: if isSignedIn() && (
        resource.data.userId == request.auth.uid ||
        resource.data.providerId == request.auth.uid
      ) || isAdmin();
      allow write: if false;
    }

    // ------------------------------------------------------------- payments

    // payments/{paymentIntentId} — the payment gateway's state for one
    // checkout: status, who paid, the amount asked for, and whether the thing
    // paid for has been granted.
    //
    // Written ONLY by the server, with the Admin SDK, from
    // functions/src/payments.ts. Admin writes bypass these rules entirely, so
    // the rules here exist to lock out everyone else.
    match /payments/{paymentIntentId} {
      // `get` only, never `list`. The owner needs to poll their own payment
      // while the wallet confirms, and the document id is the provider's
      // payment-intent id — which they already have, because the server just
      // handed it to them. Withholding `list` means nobody can enumerate the
      // collection to discover other people's payment ids or how much the
      // platform is taking in.
      allow get: if isSignedIn() && resource.data.uid == request.auth.uid;

      // Admins can work the review queue: a payment that arrived but could not
      // be matched to an account, or whose amount did not match, is parked
      // with needsReview and somebody has to find it. That needs `list`.
      allow get, list: if isAdmin();

      // NO CLIENT WRITES, EVER — not create, not update, not delete, and not
      // by an admin either. A client that could write here could mark its own
      // payment `fulfilled` and take a D200 consultation for nothing. The only
      // thing that may move payment state is the signed Modem Pay webhook
      // (the modemWebhook Cloud Function), which runs server-side with the
      // Admin SDK and so is not subject to this rule.
      allow write: if false;
    }

    // entitlements/{uid} — the AI consultation somebody has paid for, written
    // by the same server transaction that marks the payment fulfilled.
    //
    // A collection of its own, NOT a field on users/{uid}: that document is
    // self-writable (keepsPrivilegeFields pins only the role fields), so a
    // flag there would let anybody grant themselves the D200 consultation
    // from the browser console. Here nobody writes but the server.
    match /entitlements/{uid} {
      // The owner reads their own, so the page knows whether to show the
      // payment sheet or start the conversation. `get` only: no listing.
      allow get: if isSignedIn() && request.auth.uid == uid;
      allow get, list: if isAdmin();
      allow write: if false;
    }

    // payouts/{id} — money sent to a provider. Server-written only: a provider
    // who could write here could mark sessions paid out to nobody, or a
    // payout complete that never left. They read their own.
    match /payouts/{payoutId} {
      allow get: if isSignedIn() && resource.data.providerId == request.auth.uid;
      allow list: if isSignedIn() && resource.data.providerId == request.auth.uid;
      allow get, list: if isAdmin();
      allow write: if false;
    }

    // payoutAccounts/{uid} — where a provider is paid. Written only through
    // the savePayoutAccount function, which checks it and keeps every change:
    // where money goes is the first thing a stolen session would change.
    match /payoutAccounts/{uid} {
      allow get: if isSelf(uid) || isAdmin();
      allow write: if false;
      match /changes/{changeId} {
        allow read: if isSelf(uid) || isAdmin();
        allow write: if false;
      }
    }

    // paymentEvents/{eventKey} — the webhook idempotency ledger. One document
    // per delivery acted on, keyed by the provider's event id or a hash of the
    // raw body.
    //
    // Nobody reads it but the server, inside the transaction that writes it.
    // Exposing it to a client would be handing out a list of event keys, and a
    // client that could CREATE one could pre-record a real event's key and
    // make the genuine webhook skip it as a duplicate — a payment taken and
    // never fulfilled. So this one is closed completely, including to admins,
    // who have the Firebase console if they ever genuinely need to look.
    match /paymentEvents/{eventKey} {
      allow read, write: if false;
    }

    // ------------------------------------------------------------ resources

    // Wellbeing Resource Centre. Published entries are free to read, signed in
    // or not — the concept note makes this the free tier. So is a withdrawn
    // one, which holds no words, only the fact (app/lib/content/resources.ts):
    // the site reads it to stop showing the starter copy of an article that
    // ships in code. Written only by the publishResource, unpublishResource
    // and revertResource functions, which check the caller is staff, validate
    // the article, keep what it replaced and audit the change.
    match /resources/{resourceId} {
      allow get, list: if resource.data.status in ['published', 'withdrawn'] || isAdmin();
      allow write: if false;
    }

    // ---------------------------------------------------------- site content

    // The public site's words, pictures and colours: app/lib/content/schema.ts.
    //
    // Published content is read by everyone, signed in or not — the web
    // server reads it over the REST API with no credentials at all, so these
    // rules are the whole of its access. Only the publishContent and
    // revertContent functions write it, after checking the caller is staff
    // and validating it. Nothing in it names a person: who published what is
    // in siteContentVersions and auditLogs, which only staff read.
    match /siteContent/{sectionId} {
      allow get, list: if true;
      allow write: if false;
    }

    // Work in progress, saved as staff type. Never public: a page half
    // rewritten is nobody's business until it is published.
    match /siteContentDrafts/{sectionId} {
      // SECTIONS in app/lib/content/schema.ts — keep them equal.
      function contentSections() {
        return ['home', 'about', 'how-it-works', 'for-providers', 'for-institutions', 'providers',
                'plans', 'safety', 'technology', 'community', 'support', 'resources', 'privacy',
                'terms', 'header', 'footer', 'seo', 'theme'];
      }

      allow read: if isAdmin();
      allow create, update: if isAdmin()
        && sectionId in contentSections()
        && request.resource.data.keys().hasAll(['data', 'baseRev', 'updatedAt', 'updatedBy'])
        && request.resource.data.keys().hasOnly(['data', 'baseRev', 'updatedAt', 'updatedBy'])
        && request.resource.data.data is map
        && request.resource.data.baseRev is int
        && request.resource.data.updatedAt is int
        && request.resource.data.updatedBy == request.auth.uid;
      allow delete: if isAdmin();
    }

    // What each publish or revert replaced, so it can be put back. Written
    // by the functions alone; a history staff could edit would not be one.
    match /siteContentVersions/{versionId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    // The media library: one record per uploaded picture, as public as the
    // picture itself. Written by the functions, which check the upload.
    match /siteMedia/{mediaId} {
      allow get, list: if true;
      allow write: if false;
    }

    // An article in the resource centre, as staff write it: saved as they
    // type, and as private as a page's draft. The id is the article's own —
    // "seed-grief" or a Firestore auto id (RESOURCE_ID in resources.ts).
    match /resourceDrafts/{resourceId} {
      allow read: if isAdmin();
      allow create, update: if isAdmin()
        && resourceId.matches('^[A-Za-z0-9-]{1,64}$')
        && request.resource.data.keys().hasAll(['data', 'baseRev', 'updatedAt', 'updatedBy'])
        && request.resource.data.keys().hasOnly(['data', 'baseRev', 'updatedAt', 'updatedBy'])
        && request.resource.data.data is map
        && request.resource.data.baseRev is int
        && request.resource.data.updatedAt is int
        && request.resource.data.updatedBy == request.auth.uid;
      allow delete: if isAdmin();
    }

    // What each change to an article replaced, so it can be put back. Like
    // the pages' history: read by staff, written by the functions alone.
    match /resourceVersions/{versionId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    // ------------------------------------------------------ support requests

    // Contact form. Anyone may submit, signed in or not — an organisation
    // enquiring about packages has no account yet, and neither does someone
    // reporting a problem that stopped them signing up.
    //
    // Write-only from the client: nobody can read the queue back, so one
    // submitter cannot enumerate other people's messages.
    //
    // A request arrives exactly as SupportForm writes it: new, stamped with
    // the server's time, and filed under nobody's account but the sender's
    // own. So a submitter cannot file one already resolved, assign it, add
    // staff notes to it, or put it in another person's name. Staff then work
    // it only through the adminUpdateSupport function, which writes the
    // audit log — never from the browser.
    match /supportRequests/{requestId} {
      allow get, list: if isAdmin();
      allow create: if request.resource.data.keys().hasOnly(['name', 'email', 'topic', 'message', 'userId', 'status', 'createdAt'])
        && request.resource.data.keys().hasAll(['name', 'email', 'topic', 'message', 'userId', 'status', 'createdAt'])
        && request.resource.data.name is string
        && request.resource.data.name.size() <= 200
        && request.resource.data.message is string
        && request.resource.data.message.size() > 0
        && request.resource.data.message.size() < 5000
        && request.resource.data.email is string
        && request.resource.data.email.size() < 320
        && request.resource.data.topic in ['general', 'account', 'booking', 'provider', 'organisation', 'safety']
        && request.resource.data.status == 'new'
        && request.resource.data.createdAt == request.time
        && (request.resource.data.userId == null
          || (isSignedIn() && request.resource.data.userId == request.auth.uid));
      allow update, delete: if false;
    }

    // ---------------------------------------------------------- escalations

    // Crisis escalations. A user can raise one; only admins can read the queue
    // or work it.
    match /escalations/{escalationId} {
      allow get, list: if isAdmin()
        || (isSignedIn() && resource.data.userId == request.auth.uid);
      allow create: if isSignedIn()
        && request.resource.data.userId == request.auth.uid;
      allow update, delete: if isAdmin();
    }

    // -------------------------------------------------------- organizations

    match /organizations/{orgId} {
      function isOrgAdmin() {
        return isSignedIn()
          && exists(/databases/$(database)/documents/organizations/$(orgId)/members/$(request.auth.uid))
          && get(/databases/$(database)/documents/organizations/$(orgId)/members/$(request.auth.uid)).data.orgRole == 'admin';
      }

      allow get: if isOrgAdmin()
        || isAdmin()
        || (isSignedIn() && exists(/databases/$(database)/documents/organizations/$(orgId)/members/$(request.auth.uid)));
      allow list: if isAdmin();
      allow create, update: if isOrgAdmin() || isAdmin();
      allow delete: if isAdmin();

      match /members/{memberId} {
        allow get: if isSelf(memberId) || isOrgAdmin() || isAdmin();
        allow list: if isOrgAdmin() || isAdmin();
        allow write: if isOrgAdmin() || isAdmin();
      }
    }

    // ------------------------------------------------------------ audit logs

    // Written server-side only. Admins read; nobody edits.
    match /auditLogs/{logId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    // ------------------------------------------------------ staff analytics

    // presence/{uid} — "signed in and here now", for the staff numbers. The
    // person's own browser writes it once a minute while a page is on screen
    // (app/lib/analytics/usePresence.ts): the server's time and which part of
    // the app they are in, and not one field more. Nobody reads it back, the
    // owner included; the adminStats function only counts it.
    //
    // Under it, one marker for each day, week and month they were here, so
    // daily, weekly and monthly actives are each a single count of one kind
    // of marker. A marker is only accepted for the period the server's clock
    // is in: nobody back-fills a month of activity, or one for next week.
    match /presence/{uid} {
      function exactly(fields) {
        return request.resource.data.keys().hasOnly(fields)
          && request.resource.data.keys().hasAll(fields);
      }
      // "2026-10-14" as the start of that UTC day.
      function dayOf(key) {
        return timestamp.date(int(key[0:4]), int(key[5:7]), int(key[8:10]));
      }

      allow read: if false;
      allow create, update: if isSelf(uid)
        && exactly(['lastSeenAt', 'area'])
        && request.resource.data.lastSeenAt == request.time
        && request.resource.data.area in ['app', 'talk', 'chat', 'call'];
      // Theirs to remove, with the rest of their account.
      allow delete: if isSelf(uid);

      match /presenceDays/{day} {
        allow read: if false;
        allow create, update: if isSelf(uid)
          && exactly(['day', 'at'])
          && request.resource.data.day == day
          && request.resource.data.at == request.time
          && day.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
          && dayOf(day) == request.time.date();
        allow delete: if isSelf(uid);
      }

      // Named by the Monday that starts the week.
      match /presenceWeeks/{week} {
        allow read: if false;
        allow create, update: if isSelf(uid)
          && exactly(['week', 'at'])
          && request.resource.data.week == week
          && request.resource.data.at == request.time
          && week.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
          && dayOf(week).dayOfWeek() == 1
          && dayOf(week) <= request.time
          && request.time < dayOf(week) + duration.value(7, 'd');
        allow delete: if isSelf(uid);
      }

      match /presenceMonths/{month} {
        allow read: if false;
        allow create, update: if isSelf(uid)
          && exactly(['month', 'at'])
          && request.resource.data.month == month
          && request.resource.data.at == request.time
          && month.matches('^[0-9]{4}-[0-9]{2}$')
          && int(month[0:4]) == request.time.year()
          && int(month[5:7]) == request.time.month();
        allow delete: if isSelf(uid);
      }
    }

    // The rest is the functions' alone (functions/src/adminStats.ts), closed
    // to every client, staff included — staff see these only as the totals
    // the adminStats function returns. A client that could write here could
    // invent visitors or conversations; one that could read the quota could
    // see who talked to TALK today.
    //
    //   talkSessionStats/{id}  one TALK conversation, with no uid
    //   liveVisitors/{sid}     a tab open on the site now (expires)
    //   trafficDaily/{day}     a day's page views and visits
    //   adminStatsCache/{key}  one range's figures, kept five minutes
    //   analyticsQuota/{uid}   how many conversation reports today
    match /talkSessionStats/{id} {
      allow read, write: if false;
    }
    match /liveVisitors/{sid} {
      allow read, write: if false;
    }
    match /trafficDaily/{day} {
      allow read, write: if false;
    }
    match /adminStatsCache/{key} {
      allow read, write: if false;
    }
    match /analyticsQuota/{uid} {
      allow read, write: if false;
    }

    // ---------------------------------------------------- staff operations

    // Staff operations — people, sessions, payments, support and the audit
    // log — read and write only through the adminOps callables
    // (functions/src/adminOps.ts), which check the role themselves and run
    // with admin rights. They add no collection of their own, so nothing is
    // opened here: support requests and audit logs, the two they work on,
    // are guarded in their own blocks above.

    // ------------------------------------------------------ legacy: media/

    // Pre-existing base64 avatar store from app/lib/media.ts. Superseded by
    // Storage but still readable so nothing breaks; writes stay owner-only.
    match /media/{mediaId} {
      allow read: if isSignedIn();
      allow write: if isSignedIn()
        && request.resource.data.ownerId == request.auth.uid;
    }

    // ------------------------------------------------------------- catch-all

    // Anything not matched above is denied. Adding a collection means adding a
    // rule for it, on purpose.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
