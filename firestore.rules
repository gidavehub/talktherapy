rules_version = '2';

// Talk — Firestore security rules.
//
// Threat model worth stating plainly: this database holds journal entries,
// mood history and mental-health disclosures. A read leak here is not a bug,
// it is a harm. So the default is deny, private data lives in subcollections
// under its owner (making the rule a trivial uid match), and nothing is
// readable "because you are signed in".
//
// Role lives on users/{uid}.role and is read back with get(). Custom claims
// would be cheaper, but they require the Admin SDK (Blaze plan), which this
// project is not on yet. Every get() below costs a document read and Firestore
// caps them at 10 per request, so helpers are kept shallow deliberately.
//
// Bootstrapping the first admin: create the user normally, then edit
// users/{uid}.role to "admin" by hand in the Firebase console. No code path
// can mint an admin — see the role-escalation guard in /users/{uid}.

service cloud.firestore {
  match /databases/{database}/documents {

    // ---------------------------------------------------------------- helpers

    function isSignedIn() {
      return request.auth != null;
    }

    function isSelf(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    function userDoc() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function hasRole(role) {
      return isSignedIn() && userDoc().role == role;
    }

    function isAdmin() {
      return hasRole('admin');
    }

    // A provider who has actually cleared credential review. Anything that
    // exposes a provider to patients must check this, not just the role.
    function isVerifiedProvider() {
      return isSignedIn()
        && userDoc().role == 'provider'
        && userDoc().verified == true;
    }

    // Fields a user may never set on themselves. Privilege escalation guard.
    function keepsPrivilegeFields(existing) {
      return request.resource.data.role == existing.role
        && request.resource.data.verified == existing.verified;
    }

    // ------------------------------------------------------------------ users

    match /users/{uid} {
      // A user reads their own doc. Admins read anyone. Providers do NOT get
      // blanket read over patients — they see only the patients who booked
      // them, and that link is resolved through /bookings, not here.
      allow get: if isSelf(uid) || isAdmin();
      allow list: if isAdmin();

      // On create you may only make yourself, only as patient or provider,
      // and `verified` is forced: patients are trivially verified (the flag is
      // meaningless for them), providers must start unverified and be
      // approved by an admin.
      allow create: if isSelf(uid)
        && request.resource.data.role in ['patient', 'provider']
        && request.resource.data.verified == (request.resource.data.role == 'patient');

      // Self-updates may not touch role or verified. Admins may change both.
      allow update: if (isSelf(uid) && keepsPrivilegeFields(resource.data))
        || isAdmin();

      // Account deletion is a data right, so owners may delete themselves.
      allow delete: if isSelf(uid) || isAdmin();

      // ------------------------------------------------ private wellbeing data
      //
      // Mood, journal and consent history. Owner only — no admin read, no
      // provider read, ever. If a provider needs context, the patient
      // shares it deliberately through a session note, not by us opening a
      // back door here.

      match /moodEntries/{entryId} {
        allow read, write: if isSelf(uid);
      }

      match /journalEntries/{entryId} {
        allow read, write: if isSelf(uid);
      }

      // Append-only consent ledger. Users can see what they agreed to and
      // when; nobody can rewrite history, including them.
      match /consentEvents/{eventId} {
        allow read: if isSelf(uid) || isAdmin();
        allow create: if isSelf(uid);
        allow update, delete: if false;
      }
    }

    // ------------------------------------------------------- provider profiles

    match /providerProfiles/{uid} {
      // The public directory only ever shows verified providers. Unverified
      // and suspended profiles are visible to their owner and to admins.
      allow get, list: if resource.data.status == 'verified'
        || isSelf(uid)
        || isAdmin();

      // A provider writes their own profile but can never self-approve.
      allow create: if isSelf(uid)
        && hasRole('provider')
        && request.resource.data.status in ['draft', 'pending'];

      allow update: if (isSelf(uid) && request.resource.data.status == resource.data.status)
        || isAdmin();

      allow delete: if isAdmin();

      // Credential documents (certificates, ID). Owner and admin only.
      //
      // NOTE: these docs hold Storage download URLs, which are capability
      // URLs — anyone holding one can fetch the file regardless of Storage
      // rules. Gating the URL here is what actually restricts access.
      // TODO(security): before public launch, move to Admin-SDK-issued signed
      // URLs with an expiry so a leaked link stops working.
      match /privateDocs/{docId} {
        allow read: if isSelf(uid) || isAdmin();
        allow create, update: if isSelf(uid);
        allow delete: if isSelf(uid) || isAdmin();
      }
    }

    // Credential review queue.
    match /verificationRequests/{requestId} {
      allow get, list: if isAdmin()
        || (isSignedIn() && resource.data.providerId == request.auth.uid);
      allow create: if isSignedIn()
        && request.resource.data.providerId == request.auth.uid
        && request.resource.data.status == 'pending';
      // Only an admin decides. The applicant cannot move their own request.
      allow update, delete: if isAdmin();
    }

    // -------------------------------------------------------- availability

    match /availability/{providerId} {
      allow read: if isSignedIn();
      allow write: if isSelf(providerId) || isAdmin();

      match /slots/{slotId} {
        // Patients must see open slots to book them.
        allow read: if isSignedIn();
        allow write: if isSelf(providerId) || isAdmin();
      }
    }

    // ------------------------------------------------------------- bookings

    match /bookings/{bookingId} {
      // `participants` is a denormalised [patientId, providerId]. It lets one
      // composite index serve "my bookings" for both roles, and makes this rule
      // a membership test with zero extra document reads.
      function isParticipant() {
        return isSignedIn() && request.auth.uid in resource.data.participants;
      }

      allow get, list: if isParticipant() || isAdmin();

      // NO CLIENT WRITES. Booking and cancelling both go through
      // app/lib/server/bookings.ts, which runs with the Admin SDK and so is
      // not subject to this rule.
      //
      // This used to allow a patient to create their own booking, and that
      // could not be made safe. A booking and the slot it takes have to change
      // together, and a patient cannot write a provider's slots — so a
      // client-side booking left the slot looking free, and the second patient
      // to choose that time found out when nobody joined the call. The server
      // does both in one transaction, reading the slot's state inside it.
      //
      // The fee is the other half: it is read from the provider's profile
      // there, never sent by the client, so nobody books a D3,000 session for
      // a dalasi.
      allow create, update: if isAdmin();

      allow delete: if isAdmin();
    }

    // ------------------------------------------------------------- sessions

    match /sessions/{sessionId} {
      function isSessionParticipant() {
        return isSignedIn() && request.auth.uid in resource.data.participants;
      }

      allow get, list: if isSessionParticipant() || isAdmin();
      allow create: if isSignedIn()
        && request.resource.data.patientId == request.auth.uid
        && request.auth.uid in request.resource.data.participants;
      allow update: if isSessionParticipant() || isAdmin();
      allow delete: if isAdmin();

      // Transcript / in-session chat.
      //
      // `participants` is denormalised onto every message ON PURPOSE. The
      // obvious rule — get() the parent session — costs a billed read on every
      // single message write, and a companion conversation produces hundreds.
      // At free-tier quota (50k reads/day) that alone would sink the app.
      // Denormalising trades a few bytes per document for zero reads.
      match /messages/{messageId} {
        allow read: if (isSignedIn() && request.auth.uid in resource.data.participants)
          || isAdmin();
        allow create: if isSignedIn()
          && request.auth.uid in request.resource.data.participants;
        // Immutable once written — a therapy transcript nobody can quietly
        // edit is worth more than a convenient one.
        allow update, delete: if false;
      }

      // Clinical notes. Written by the provider, never visible to the
      // patient through this path, never visible to other providers.
      match /notes/{noteId} {
        allow read, write: if isSignedIn()
          && get(/databases/$(database)/documents/sessions/$(sessionId)).data.providerId == request.auth.uid;
      }
    }

    // ---------------------------------------------------------------- chats

    // Conversations between a person and the provider they are working with.
    // This collection holds the same class of disclosure as a journal entry,
    // so "deny unless you are in the participant list" is doing real work
    // here, not paperwork.
    //
    // There is no admin read. An admin can already escalate a crisis without
    // reading the conversation, and a support team able to open anyone's
    // therapy chat is a far bigger liability than the occasional support
    // ticket it would resolve.
    match /chats/{chatId} {
      function isChatParticipant() {
        return isSignedIn() && request.auth.uid in resource.data.participants;
      }

      // `list` is safe to allow on the same condition because Firestore
      // evaluates it against every document a query actually returns: the
      // chat-list query filters on `participants array-contains <me>`, and a
      // query that reached somebody else's chat would be refused outright
      // rather than filtered.
      allow get, list: if isChatParticipant();

      // Whoever opens the conversation must be in it. Two is the minimum; the
      // ceiling is a brake on a script creating a thousand-person thread, not
      // a product limit — group sessions are nowhere near 50.
      //
      // The last clause is the one that is easy to miss: a two-person chat's
      // id IS its participants, sorted and joined with "__" (see
      // directChatId), and that has to be enforced here rather than trusted.
      // Without it a stranger can create the document at the id two other
      // people's chat WOULD have, with themselves as the only participant.
      // They could never read it — but the real patient could never open it
      // either, because `openChat` would then be making an update to a chat
      // it is not a participant of, and be refused for ever. A conversation
      // that can be pre-emptively broken by anybody who knows two uids is not
      // a conversation.
      //
      // Group chats get a generated id with nothing to check it against, so
      // the clause only applies to the pair case.
      allow create: if isSignedIn()
        && request.auth.uid in request.resource.data.participants
        && request.resource.data.participants.size() >= 2
        && request.resource.data.participants.size() <= 50
        && (request.resource.data.participants.size() > 2
            || chatId == request.resource.data.participants.join('__'));

      // Participants are immutable, and this is the most important line in the
      // block. Everything else here — the preview, the unread counters, the
      // typing timestamps — is written by both sides in the ordinary course of
      // sending a message, so the rule has to stay permissive about those.
      // But adding a uid to a live chat would retroactively hand that person
      // every message already in it, because the message rule below trusts the
      // same array. Pinning it is what stops a participant doing that.
      allow update: if isChatParticipant()
        && request.resource.data.participants == resource.data.participants;

      // Nobody deletes a conversation from the client. One side deleting the
      // thread would destroy the other person's copy of it, and a therapeutic
      // record is not one party's to erase.
      allow delete: if false;

      match /messages/{messageId} {
        // `participants` is copied from the parent chat onto every message ON
        // PURPOSE, exactly as the session transcript above does it. The
        // obvious rule — get() the parent chat on every read — bills a
        // document read per message read, and a conversation that is working
        // produces hundreds against a 50k reads/day quota.
        //
        // Reads therefore trust the copied array. What makes that safe is the
        // create rule below, which is the only thing that ever writes it.
        allow read: if isSignedIn()
          && request.auth.uid in resource.data.participants;

        // You may only write a message as yourself, into a chat you are in,
        // carrying that chat's real participant list.
        //
        // This get() is the one read this design does pay for, and it is not
        // optional. Checking only `request.resource.data.participants` tests
        // an array the sender just made up: anybody signed in could write a
        // message into any chat id they can derive from two uids, listing
        // whoever they like. They still could not read the thread — but
        // "rules are not filters" means a single injected message that omits
        // one participant makes that person's whole thread query fail, and
        // their conversation vanishes. Verified against the live evaluator in
        // scripts/test-security-rules.mjs, which is where this hole was found.
        //
        // The cost is one document read per message SENT, never per message
        // read, so the quota argument above is untouched.
        allow create: if isSignedIn()
          && request.resource.data.senderId == request.auth.uid
          && request.auth.uid in request.resource.data.participants
          && request.resource.data.participants
               == get(/databases/$(database)/documents/chats/$(chatId)).data.participants;

        // Read receipts are the single permitted mutation, and only your own.
        // The diff must touch nothing but `readBy`, and the only uid it may
        // add is the caller's: without that last clause a participant could
        // mark a message read on someone else's behalf, which is a small lie
        // with an outsized effect on whether a person feels heard.
        //
        // Everything else about a message stays immutable once written, for
        // the same reason the session transcript does.
        allow update: if isSignedIn()
          && request.auth.uid in resource.data.participants
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['readBy'])
          && request.resource.data.readBy is list
          && request.resource.data.readBy.hasAll(resource.data.readBy)
          && request.resource.data.readBy.removeAll(resource.data.readBy)
               .hasOnly([request.auth.uid]);

        allow delete: if false;
      }
    }

    // ------------------------------------------------- WebRTC call signaling

    // Short-lived SDP offer/answer and ICE candidates. Contents are useless
    // without also being the live peer, but they still identify who is talking
    // to whom, so they stay locked to the two participants.
    match /calls/{sessionId} {
      // Same denormalisation as messages: ICE candidates arrive in bursts of
      // dozens, and a parent lookup per candidate is pure waste.
      function isCallParticipant() {
        return isSignedIn() && request.auth.uid in resource.data.participants;
      }

      allow read: if isCallParticipant();
      // The room is created by whoever arrives first, who must be a listed
      // participant, and the participant list can never be rewritten.
      allow create: if isSignedIn()
        && request.auth.uid in request.resource.data.participants;
      allow update: if isCallParticipant()
        && request.resource.data.participants == resource.data.participants;
      allow delete: if isCallParticipant();

      // Candidates inherit the room's participant list through one get() on
      // the room document — not the session — which is a single cached read
      // per request rather than one per candidate.
      function inRoom() {
        return isSignedIn() && request.auth.uid in
          get(/databases/$(database)/documents/calls/$(sessionId)).data.participants;
      }

      match /callerCandidates/{candidateId} {
        allow read, write: if inRoom();
      }

      match /calleeCandidates/{candidateId} {
        allow read, write: if inRoom();
      }
    }

    // --------------------------------------------------------- transactions

    // Money is server-authoritative. Clients read their own history and write
    // nothing — every mutation comes from the Modem Pay webhook route handler.
    match /transactions/{transactionId} {
      allow get, list: if isSignedIn() && (
        resource.data.userId == request.auth.uid ||
        resource.data.providerId == request.auth.uid
      ) || isAdmin();
      allow write: if false;
    }

    // ------------------------------------------------------------- payments

    // payments/{paymentIntentId} — the payment gateway's state for one
    // checkout: status, who paid, the amount asked for, and whether the thing
    // paid for has been granted.
    //
    // Written ONLY by the server, with the Admin SDK, from
    // app/lib/payments/store.ts. Admin writes bypass these rules entirely, so
    // the rules here exist to lock out everyone else.
    match /payments/{paymentIntentId} {
      // `get` only, never `list`. The owner needs to poll their own payment
      // while the wallet confirms, and the document id is the provider's
      // payment-intent id — which they already have, because the server just
      // handed it to them. Withholding `list` means nobody can enumerate the
      // collection to discover other people's payment ids or how much the
      // platform is taking in.
      allow get: if isSignedIn() && resource.data.uid == request.auth.uid;

      // Admins can work the review queue: a payment that arrived but could not
      // be matched to an account, or whose amount did not match, is parked
      // with needsReview and somebody has to find it. That needs `list`.
      allow get, list: if isAdmin();

      // NO CLIENT WRITES, EVER — not create, not update, not delete, and not
      // by an admin either. A client that could write here could mark its own
      // payment `fulfilled` and take a D200 consultation for nothing. The only
      // thing that may move payment state is the signed Modem Pay webhook
      // (app/api/payments/modem/webhook), which runs server-side with the
      // Admin SDK and so is not subject to this rule.
      allow write: if false;
    }

    // paymentEvents/{eventKey} — the webhook idempotency ledger. One document
    // per delivery acted on, keyed by the provider's event id or a hash of the
    // raw body.
    //
    // Nobody reads it but the server, inside the transaction that writes it.
    // Exposing it to a client would be handing out a list of event keys, and a
    // client that could CREATE one could pre-record a real event's key and
    // make the genuine webhook skip it as a duplicate — a payment taken and
    // never fulfilled. So this one is closed completely, including to admins,
    // who have the Firebase console if they ever genuinely need to look.
    match /paymentEvents/{eventKey} {
      allow read, write: if false;
    }

    // ------------------------------------------------------------ resources

    // Wellbeing Resource Centre. Published entries are free to read, signed in
    // or not — the concept note makes this the free tier.
    match /resources/{resourceId} {
      allow get, list: if resource.data.status == 'published' || isAdmin();
      allow write: if isAdmin();
    }

    // ------------------------------------------------------ support requests

    // Contact form. Anyone may submit, signed in or not — an organisation
    // enquiring about packages has no account yet, and neither does someone
    // reporting a problem that stopped them signing up.
    //
    // Write-only from the client: nobody can read the queue back, so one
    // submitter cannot enumerate other people's messages.
    match /supportRequests/{requestId} {
      allow get, list: if isAdmin();
      allow create: if request.resource.data.keys().hasAll(['name', 'email', 'message'])
        && request.resource.data.message is string
        && request.resource.data.message.size() > 0
        && request.resource.data.message.size() < 5000
        && request.resource.data.email is string
        && request.resource.data.email.size() < 320;
      allow update, delete: if isAdmin();
    }

    // ---------------------------------------------------------- escalations

    // Crisis escalations. A user can raise one; only admins can read the queue
    // or work it.
    match /escalations/{escalationId} {
      allow get, list: if isAdmin()
        || (isSignedIn() && resource.data.userId == request.auth.uid);
      allow create: if isSignedIn()
        && request.resource.data.userId == request.auth.uid;
      allow update, delete: if isAdmin();
    }

    // -------------------------------------------------------- organizations

    match /organizations/{orgId} {
      function isOrgAdmin() {
        return isSignedIn()
          && exists(/databases/$(database)/documents/organizations/$(orgId)/members/$(request.auth.uid))
          && get(/databases/$(database)/documents/organizations/$(orgId)/members/$(request.auth.uid)).data.orgRole == 'admin';
      }

      allow get: if isOrgAdmin()
        || isAdmin()
        || (isSignedIn() && exists(/databases/$(database)/documents/organizations/$(orgId)/members/$(request.auth.uid)));
      allow list: if isAdmin();
      allow create, update: if isOrgAdmin() || isAdmin();
      allow delete: if isAdmin();

      match /members/{memberId} {
        allow get: if isSelf(memberId) || isOrgAdmin() || isAdmin();
        allow list: if isOrgAdmin() || isAdmin();
        allow write: if isOrgAdmin() || isAdmin();
      }
    }

    // ------------------------------------------------------------ audit logs

    // Written server-side only. Admins read; nobody edits.
    match /auditLogs/{logId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    // ------------------------------------------------------ legacy: media/

    // Pre-existing base64 avatar store from app/lib/media.ts. Superseded by
    // Storage but still readable so nothing breaks; writes stay owner-only.
    match /media/{mediaId} {
      allow read: if isSignedIn();
      allow write: if isSignedIn()
        && request.resource.data.ownerId == request.auth.uid;
    }

    // ------------------------------------------------------------- catch-all

    // Anything not matched above is denied. Adding a collection means adding a
    // rule for it, on purpose.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
