    {
      "id": "price",
      "clips": {
        "en": {
          "src": "/voice/onboarding/price.en.cd06ab97f2.mp3",
          "text": "To continue, the consultation is two hundred dalasi.",
          "seconds": 4.67,
          "bytes": 28368,
          "sha256": "cd06ab97f2386adb83fb24bd3f20883642d5bd0b30c244570dc3330a8b35e849"
        },
        "wo": {
          "src": "/voice/onboarding/price.wo.35eb36d5f3.mp3",
          "text": "Ngir nu wéy, consultation bi two hundred dalasi la.",
          "seconds": 4.35,
          "bytes": 26496,
          "sha256": "35eb36d5f3296e706fa7b06a10277a0cce1106e3d6b9a86cd3d181be92704af5",
          "draft": true
        }
      }
    },
    {
      "id": "why",
      "clips": {
        "en": {
          "src": "/voice/onboarding/why.en.9970cd3998.mp3",
          "text": "This first consultation helps me understand what you are going through, so I can find the right person to help you.",
          "seconds": 8.67,
          "bytes": 52416,
          "sha256": "9970cd3998d4eefeaceb8f88023cbf1097a3d2c439311bb56fad108e9260f88e"
        },
        "wo": {
          "src": "/voice/onboarding/why.wo.ff30f683e7.mp3",
          "text": "Consultation bi njëkk dina ma dimbali ma xam li ngay dundu, ngir ma man la wutalaal provider bi baax te war la dimbali.",
          "seconds": 9.11,
          "bytes": 55008,
          "sha256": "ff30f683e7289e5b4d8b2ce39692ec29d82303dd97cd1162865a4c7858970f97",
          "draft": true
        }
      }
    },
    {
      "id": "pay-how",
      "clips": {
        "en": {
          "src": "/voice/onboarding/pay-how.en.29c568dde7.mp3",
          "text": "Tap Pay, then choose Wave or your card. Approve it on your phone, and come back here.",
          "seconds": 7.84,
          "bytes": 47376,
          "sha256": "29c568dde753b22a9d4d3b8f19467222e58b88467e33f5e53df0a621516f1c78"
        },
        "wo": {
          "src": "/voice/onboarding/pay-how.wo.886de53ec3.mp3",
          "text": "Bësal Pay, daldi tànn Wave walla sa card. Confirm ko ci sa phone, nga dellusi fi.",
          "seconds": 6.37,
          "bytes": 38592,
          "sha256": "886de53ec3f52d90a8b14aaaa3b40ce8a47c4267c7e48a188fb79b6b9d3d683a",
          "draft": true
        }
      }
    },
    {
      "id": "paid",
      "clips": {
        "en": {
          "src": "/voice/onboarding/paid.en.e5c16ed1ea.mp3",
          "text": "Thank you. Now, let us begin.",
          "seconds": 3.16,
          "bytes": 19296,
          "sha256": "e5c16ed1ea55e5eb4245c6df1f6630ae0a3da11eb76837cee8495c6b47441336"
        },
        "wo": {
          "src": "/voice/onboarding/paid.wo.787491dc00.mp3",
          "text": "Jërëjëf. Léegi, nanu tàmbli.",
          "seconds": 3.23,
          "bytes": 19728,
          "sha256": "787491dc000f66069cae5e88f43c048fd33a41dd2bbd4deae7361d9d25984ef9",
          "draft": true
        }
      }
    },
    {
      "id": "welcome-back",
      "clips": {
        "en": {
          "src": "/voice/onboarding/welcome-back.en.50f8c34f42.mp3",
          "text": "Welcome back. Let us carry on.",
          "seconds": 3.64,
          "bytes": 22176,
          "sha256": "50f8c34f4288ede831641f4502d55889b292f39c143d0d24b3fc60cdc0709dd8"
        },
        "wo": {
          "src": "/voice/onboarding/welcome-back.wo.d5c093c319.mp3",
          "text": "Dalal jàmm. Nan wéy.",
          "seconds": 2.72,
          "bytes": 16704,
          "sha256": "d5c093c3190c2ee65e7263819f3a66775f6b62da0d0239f49591a81b1b6e4864",
          "draft": true
        }
      }
    },
    {
      "id": "crisis-call",
      "clips": {
        "en": {
          "src": "/voice/onboarding/crisis-call.en.5d7580a082.mp3",
          "text": "If you are in danger right now, call one-one-seven for the police, or one-one-six for an ambulance.",
          "seconds": 8.41,
          "bytes": 50832,
          "sha256": "5d7580a082a225763c4f359ae334d0b48eeb6165eee2efc4fbd28088ac585849"
        },
        "wo": {
          "src": "/voice/onboarding/crisis-call.wo.e6abe731d0.mp3",
          "text": "Su fekkee yaa ngi ci danger léegi, woo one-one-seven ngir police, walla one-one-six ngir ambulance.",
          "seconds": 6.98,
          "bytes": 42192,
          "sha256": "e6abe731d017d526fd78f6972236027915fabd988868671cfbebbfe213c6c29b",
          "draft": true
        }
      }
    },
    {
      "id": "crisis-fire",
      "clips": {
        "en": {
          "src": "/voice/onboarding/crisis-fire.en.0bc1fe415a.mp3",
          "text": "For a fire or an accident, call one-one-eight. These calls are free.",
          "seconds": 7.12,
          "bytes": 43056,
          "sha256": "0bc1fe415a3f22b9a48cbfbbd5dc1e1b422faad4ba48ac9eafe2a5455e37c75b"
        },
        "wo": {
          "src": "/voice/onboarding/crisis-fire.wo.e89efb76d6.mp3",
          "text": "Su dee lak-lak walla accident, woowalleen one-one-eight. Woté yii amuñu fay.",
          "seconds": 7.29,
          "bytes": 44064,
          "sha256": "e89efb76d6c73c276e3a6e7a2dc5eb1d674ba578b3d0327b4c24180e8b625f16",
          "draft": true
        }
      }
    },
    {
      "id": "crisis-young",
      "clips": {
        "en": {
          "src": "/voice/onboarding/crisis-young.en.082f42af4c.mp3",
          "text": "If you are under eighteen, tell an adult you trust today: a parent, a teacher, or a health worker.",
          "seconds": 8.89,
          "bytes": 53712,
          "sha256": "082f42af4cd21617f7676a9ad2eb9b3cd2fdded232329bb0372a4730d3ac4969"
        },
        "wo": {
          "src": "/voice/onboarding/crisis-young.wo.a7aec82970.mp3",
          "text": "Soo amagul eighteen, waxal tey ak mag boo wóolu: sa parent, sa teacher, walla health worker.",
          "seconds": 9.01,
          "bytes": 54432,
          "sha256": "a7aec82970e177baf729f85333afef4b32aff4418dd8dca140441191a61b82d0",
          "draft": true
        }
      }
    },
    {
      "id": "crisis-alone",
      "clips": {
        "en": {
          "src": "/voice/onboarding/crisis-alone.en.d0ab39b8af.mp3",
          "text": "You do not have to carry this on your own. Telling one person is often the hardest step, and the most useful.",
          "seconds": 10.38,
          "bytes": 62640,
          "sha256": "d0ab39b8af88609131e983f56d2fedbac2558205096ab85122c08fc7320ee8bb"
        },
        "wo": {
          "src": "/voice/onboarding/crisis-alone.wo.1fd554bbf0.mp3",
          "text": "Doo war a yenu lii yaw rekk. Wax ko benn nit mooy li gën a jafe yenn saa yi, te moo gën a am njariñ.",
          "seconds": 7.91,
          "bytes": 47808,
          "sha256": "1fd554bbf0da2ead2137b80260b386cc5e23fdb1568d4ff756940ac7183f0916",
          "draft": true
        }
      }
    }
